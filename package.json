{
  "name": "unconventionart",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/vendor.mjs && node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs && node tools/check.mjs && node --test tests/*.test.mjs",
    "setup:ar": "npm ci --prefix ar-runtime --ignore-scripts",
    "setup:upgrades": "npm ci --ignore-scripts && npm ci --prefix server/multiplayer --ignore-scripts && node tools/setup-characterstudio.mjs",
    "check:upgrades": "node tools/check-upgrades.mjs",
    "characterstudio:dev": "npm run dev --prefix research/upstream/CharacterStudio -- --host 127.0.0.1",
    "characterstudio:build": "npm run build --prefix research/upstream/CharacterStudio",
    "assets:inspect": "gltf-transform inspect",
    "assets:optimize": "gltf-transform optimize",
    "check:multiplayer": "node --test server/multiplayer/visit-room.test.mjs",
    "build:editor": "node tools/build-characterstudio.mjs"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.4",
    "@pixiv/three-vrm": "3.5.5",
    "@pmndrs/uikit": "1.0.76",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1",
    "meshoptimizer": "1.3.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "realism-effects": "1.1.2",
    "three": "0.186.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.10",
    "xatlas-web": "0.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "esbuild": "0.25.12",
    "sharp": "0.35.4"
  }
}
